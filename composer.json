{
    "name": "vanilla/laravel",
    "description": "Utilities and Commands for working with Laravel.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Vanilla\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VanillaTests\\Laravel\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Adam Charron",
            "email": "adam@charrondev.com"
        }
    ],
    "require": {
        "laravel/framework": "^10.0|^12.0|^13.0",
        "php": "^8.1",
        "vanilla/garden-utils": "^1.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vanilla\\Laravel\\Providers\\VanillaServiceProvider"
            ]
        }
    },
    "require-dev": {
        "vimeo/psalm": "^5.13|^6.0",
        "phpunit/phpunit": "^10.2|^11.0|^12.0"
    }
}
